# NEUD web + desktop development (variable names only — no secrets)
# Copy to .env.local for Next.js / local desktop dev on Windows or macOS.

# Supabase (public / publishable — safe for browser and packaged desktop)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: override Windows installer download URL on marketing pages
# NEXT_PUBLIC_NEUD_WINDOWS_DOWNLOAD_URL=

# Local desktop dev: route portal APIs to Electron local SQLite
# NEUD_USE_LOCAL_DATA=1
# NEXT_PUBLIC_NEUD_USE_LOCAL_DATA=1

# Electron dev shell (npm run dev:desktop)
# NEUD_DESKTOP_DEV=1

# Optional: embed git commit in local desktop builds (otherwise dev-local)
# NEUD_BUILD_COMMIT=

# Server-only (Vercel / trusted scripts — NEVER in desktop bundles)
# SUPABASE_SERVICE_ROLE_KEY=
